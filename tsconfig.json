{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2023"],
		"types": ["@cloudflare/workers-types"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"resolveJsonModule": true,
		"paths": { "#version-data": ["./src/generated/v777.json"] },
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["src", "plugins", "sdk"]
}
